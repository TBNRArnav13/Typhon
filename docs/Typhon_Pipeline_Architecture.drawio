        </mxCell>
        <mxCell id="rl_agent" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;arcSize=15;shadow=1;strokeWidth=3;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;align=center;" value="DQN RL Fusion Agent&#xa;(State evaluation &amp; action routing policy)" vertex="1">
          <mxGeometry height="65" width="240" x="680" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="actions" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;shadow=1;strokeWidth=2.5;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#14532D;align=center;spacingLeft=5;spacingRight=5;" value="Select Neuro-Symbolic Action Rule:&#xa;A0: Trust XGBoost | A1: Trust QST3&#xa;A2: OR Fusion | A3: AND Fusion" vertex="1">
          <mxGeometry height="100" width="180" x="710" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="c2e2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;shadow=1;strokeWidth=2.5;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#7F1D1D;align=center;spacingLeft=5;spacingRight=5;" value="C2E2 Optimization Check&#xa;(Is XGBoost confidence &gt; 99.5% ?)" vertex="1">
          <mxGeometry height="100" width="180" x="710" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="overrides" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;arcSize=15;shadow=1;strokeWidth=2;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;align=center;" value="Symbolic Override Filters&#xa;(mDNS / Local multicast benign whitelist)" vertex="1">
          <mxGeometry height="60" width="240" x="680" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="outputs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=25;shadow=1;strokeWidth=3;fillColor=#F0FDF4;strokeColor=#15803D;fontColor=#14532D;align=center;" value="Prediction Output Categorization&#xa;[Benign | Suspicious | Critical Anomaly | Zero-Day | DoS/DDoS]" vertex="1">
          <mxGeometry height="65" width="260" x="670" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="reports" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;shadow=1;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#475569;fontColor=#0F172A;align=center;" value="Report Generator&#xa;(Generates HTML / Markdown / JSON logs)" vertex="1">
          <mxGeometry height="70" width="200" x="700" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="left_panel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11.5;fontStyle=0;arcSize=6;shadow=0;strokeWidth=1.5;strokeColor=#2D7600;fillColor=#60a917;align=left;spacingLeft=15;spacingRight=15;verticalAlign=top;spacingTop=15;fontColor=#ffffff;" value="&lt;b&gt;STEP-BY-STEP SEQUENTIAL DATA FLOW&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Step 1: Data Ingestion &amp; Formatting&lt;/b&gt;&lt;br/&gt;• Network packet bytes (.pcap) or csv rows (.csv) are loaded.&lt;br/&gt;• Input Handler extracts 33 flow metrics (lengths, rates, etc.).&lt;br/&gt;• RobustScaler clamps features to standard scaling range.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Step 2: Multi-Dimensional Feature Processing&lt;/b&gt;&lt;br/&gt;• The scaled 33 features are processed simultaneously:&lt;br/&gt;  - &lt;i&gt;Concept Drift:&lt;/i&gt; JS Divergence measures profile shifts.&lt;br/&gt;  - &lt;i&gt;XGBoost:&lt;/i&gt; Checks signatures for known attacks.&lt;br/&gt;  - &lt;i&gt;CT-DGNN:&lt;/i&gt; Computes continuous-time host graph updates.&lt;br/&gt;  - &lt;i&gt;QST3:&lt;/i&gt; Feeds data sequence windows through KAN, LTC-Transformers, and MPS to reconstruct values.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Step 3: RL Decision Fusion &amp; Guardrails&lt;/b&gt;&lt;br/&gt;• Outputs from all detectors form a 6-Dimensional State Vector S.&lt;br/&gt;• DQN Fusion Agent reads S and chooses a fusion policy (A0 - A3).&lt;br/&gt;• &lt;i&gt;C2E2 Check:&lt;/i&gt; High-confidence attacks bypass fusion to save time.&lt;br/&gt;• &lt;i&gt;Symbolic Whitelisting:&lt;/i&gt; Clears safe local protocols (mDNS/multicast).&lt;br/&gt;• Predicts exact alert category and triggers log reports." vertex="1">
          <mxGeometry height="650" width="530" x="-50" y="890" as="geometry" />
        </mxCell>
        <mxCell id="right_panel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11.5;fontStyle=0;arcSize=6;shadow=0;strokeWidth=1.5;strokeColor=#2D7600;fillColor=#60a917;align=left;spacingLeft=15;spacingRight=15;verticalAlign=top;spacingTop=15;fontColor=#ffffff;" value="&lt;b&gt;POSSIBLE DECISION PATHS &amp; OUTPUT COMBINATIONS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Here are all possible pipeline output outcomes in simple words:&lt;br/&gt;&lt;br/&gt;&lt;b&gt;1. Combo A: C2E2 Exit (Known Attack)&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Condition:&lt;/i&gt; Supervised XGBoost is extremely confident (&amp;gt;99.5%).&lt;br/&gt;• &lt;i&gt;Output:&lt;/i&gt; &lt;b&gt;&#39;DoS/DDoS&#39; (Known Signature)&lt;/b&gt;. Full fusion is bypassed.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;2. Combo B: Trusted Signature Match (Action 0)&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Condition:&lt;/i&gt; DQN chooses Action 0. XGBoost finds signature match.&lt;br/&gt;• &lt;i&gt;Output:&lt;/i&gt; &lt;b&gt;&#39;DoS/DDoS&#39; (Known Signature)&lt;/b&gt;.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;3. Combo C: Zero-Day / Critical Outlier (Action 1)&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Condition:&lt;/i&gt; DQN chooses Action 1. QST3 reconstruction error is higher than mathematical threshold, but XGBoost sees no signature match.&lt;br/&gt;• &lt;i&gt;Output:&lt;/i&gt; &lt;b&gt;&#39;Zero-Day Outlier&#39;&lt;/b&gt; (New, unrecognized anomaly).&lt;br/&gt;&lt;br/&gt;&lt;b&gt;4. Combo D: High-Sensitivity Warnings (Action 2)&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Condition:&lt;/i&gt; DQN chooses Action 2 (OR Union) during drift alerts. Either model flags.&lt;br/&gt;• &lt;i&gt;Output:&lt;/i&gt; &lt;b&gt;&#39;Suspicious&#39;&lt;/b&gt; or &lt;b&gt;&#39;Critical Anomaly&#39;&lt;/b&gt; (Aggressive warn).&lt;br/&gt;&lt;br/&gt;&lt;b&gt;5. Combo E: Noisy/Normal Operations (Action 3)&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Condition:&lt;/i&gt; DQN chooses Action 3 (AND Intersection). Only one model flags.&lt;br/&gt;• &lt;i&gt;Output:&lt;/i&gt; &lt;b&gt;&#39;Benign&#39; (Safe flow)&lt;/b&gt;. Avoids false alarms during noisy spikes.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;6. Combo F: Whitelist Override&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Condition:&lt;/i&gt; Output is flagged as alert, but ports match local discovery (5353, 224.*).&lt;br/&gt;• &lt;i&gt;Output:&lt;/i&gt; Overridden back to &lt;b&gt;&#39;Benign&#39; (Safe local discovery)&lt;/b&gt;." vertex="1">
          <mxGeometry height="650" width="530" x="1040" y="900" as="geometry" />
        </mxCell>
